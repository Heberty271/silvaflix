# Copie este arquivo para ".env" e ajuste os valores

# Chave secreta usada para assinar os tokens JWT.
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-aleatoriamente

# Tempo de expiracao do token de login, em minutos
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Pasta onde os arquivos de video ficam armazenados. NAO precisa ser uma
# pasta dentro do projeto - pode (e deve, se voce tiver muitos filmes)
# apontar direto para um HD/pendrive inteiro, com filmes organizados em
# subpastas. O sistema varre subpastas automaticamente.
#
# Exemplos:
#   Windows (HD externo na unidade E):  MEDIA_MOVIES_DIR=E:\Filmes
#   Windows (HD interno secundario):    MEDIA_MOVIES_DIR=D:\Midia\Filmes
#   Mac:                                 MEDIA_MOVIES_DIR=/Volumes/MeuHD/Filmes
#   Linux:                               MEDIA_MOVIES_DIR=/mnt/meuhd/filmes
MEDIA_MOVIES_DIR=./media/movies

# Pasta onde as capas (thumbnails) ficam armazenadas - essa pode continuar
# dentro do projeto normalmente, sao so imagens pequenas
MEDIA_THUMBS_DIR=./media/thumbnails

# Origem do frontend, para liberar o CORS (separar por virgula se houver mais de uma)
CORS_ORIGINS=http://localhost:3000

# Chave gratuita do TMDB (The Movie Database), para autopreencher os dados
# dos filmes ao cadastrar. Crie a sua em themoviedb.org > Configuracoes > API
TMDB_API_KEY=coloque-sua-chave-aqui

# Idioma dos dados retornados pelo TMDB (sinopse, generos etc)
TMDB_LANGUAGE=pt-BR
